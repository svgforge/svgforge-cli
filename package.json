{
  "name": "@svgforge/svgforge-cli",
  "version": "3.0.0",
  "author": "svgforge (https://github.com/SpotlightOn)",
  "description": "Command line interface for svgforge \u2014 create SVG sprites & stacks with stylesheet resources (CSS, Sass, etc.)",
  "homepage": "https://github.com/svgforge/svgforge-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svgforge/svgforge-cli.git"
  },
  "bugs": {
    "url": "https://github.com/svgforge/svgforge-cli/issues"
  },
  "keywords": [
    "svg",
    "stack",
    "generator",
    "css",
    "cli",
    "command-line"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "svgforge": "./bin/svgforge.js"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "xo",
    "fix": "xo --fix",
    "test": "node --test test/*.test.js",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info"
  },
  "dependencies": {
    "@svgforge/svgforge": "^3.0.0",
    "js-yaml": "^5.4.2",
    "vinyl": "^3.0.1",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "eslint-plugin-jsdoc": "^64.5.4",
    "husky": "^9.1.7",
    "xo": "^5.0.1"
  }
}
