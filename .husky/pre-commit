#!/usr/bin/env sh
# Never commit a local link: override (see AGENTS.md).
# This guard inspects the staging area, not the working tree.

files="pnpm-workspace.yaml pnpm-lock.yaml"
offenders=""

for f in $files; do
  if git show ":$f" 2>/dev/null | grep -q 'link:'; then
    offenders="$offenders $f"
  fi
done

if [ -n "$offenders" ]; then
  echo "✗ Commit aborted: link: override in:$offenders" >&2
  echo "  Remove the override, stage the files again and commit." >&2
  exit 1
fi
